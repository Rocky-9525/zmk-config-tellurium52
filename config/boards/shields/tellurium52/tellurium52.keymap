#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/mouse.h>

// 【dyaブランチのみ】エンコーダをDYA Studioから設定できるようにする。
// cormoran/zmk-behavior-runtime-sensor-rotate が提供する。
// 安定版ブランチに戻す時はこの行と下のビヘイビア定義を元に戻すこと。
#include <behaviors/runtime-sensor-rotate.dtsi>

/*
 * ============================ 物理配置 ============================
 * 設計図(keyboard-layout.jpg)どおり。4段構成で、内側の列は半キー分下にずれる。
 *
 *  ESC  Q  W  E  R  T                          Y  U  I  O  P  ;
 *  Tab  A  S  D  F  G                          H  J  K  L  @  :
 *  Shft Z  X  C  V  B  -                  B    N  M  ,  .  /  \
 *  Ctrl Win Alt 無変換 Spc L1 L2      Ent BS Del  RSft 半/全 変換 L3
 *
 *                     [左エンコーダ] [右エンコーダ]
 *
 * 【重要】bindings の並び順は見た目の左右の並びとは違う。
 * tellurium52.dtsi の keys リストの順、つまり各段で
 *   左手 = 外側4キー(x=0〜300) → 内側(x=400〜600)
 *   右手 = 外側4キー(x=1100〜1400) → 内側(x=800〜1000)
 * の順に書く。右手は内側クラスタが後ろに来る点に注意。
 * 各行のコメントに見た目の並びを書いてあるので照合できる。
 *
 * ============================ JIS配列 ============================
 * OS側が日本語キーボード設定であることが前提(設計図に無変換・@・:があるため)。
 * JISは物理位置とHIDコードの対応がUSとずれるので以下を使う:
 *   @ → LBKT      : → SQT       \_(ろ) → INT_RO
 *   ^ → EQUAL     ¥ → INT_YEN   [ → RBKT      ] → BSLH
 *   半角/全角 → GRAVE    無変換 → INT_MUHENKAN    変換 → INT_HENKAN
 */

/*
 * ==================== エンコーダーでマウスホイールを回す ====================
 * 以前 &msc が効かなかった理由と、その対策。
 *
 * &msc は「押している間、trigger-period-ms(既定16ms)ごとに
 *   移動量 = 速度 × 16 ÷ 1000
 * を出す」方式で、離すと端数(remainder)も0に戻る。
 * 一方 zmk,behavior-sensor-rotate は内部で
 *   押す → tap-ms 待つ → 離す
 * をしており、その tap-ms の既定値が 5ms しかない。
 * 16ms周期に対して5msで離してしまうので、一度も発火せず0のままだった。
 *
 * 対策は2つ:
 *   (1) tap-ms を 25 にして、16ms の1回目だけを確実に発火させる
 *       (2回目は32msなので発火しない = 1ノッチちょうど1回)
 *   (2) 速度を 63 にして 63×16÷1000 = 1.008 ≒ ホイール1目盛/回 にする
 *       既定の SCRL_UP は速度10しかなく、1目盛出すのに約112ms必要だった。
 *
 * 調整方法:
 *   スクロール量を増やす → ENC_SCRL を 126(2目盛) 189(3目盛) などに
 *   全く動かない場合     → tap-ms を 40 に(発火2回=2目盛になる)
 */
#define ENC_SCRL  63
#define ENC_UP    MOVE_Y(ENC_SCRL)
#define ENC_DOWN  MOVE_Y(-ENC_SCRL)
#define ENC_LEFT  MOVE_X(-ENC_SCRL)
#define ENC_RIGHT MOVE_X(ENC_SCRL)

/ {
    behaviors {
        /*
         * 【dyaブランチのみ】標準の zmk,behavior-sensor-rotate ではなく
         * zmk,behavior-runtime-sensor-rotate を使う。DYA Studio から
         * 回転の割り当てをレイヤーごとに書き換えられるようになる。
         *
         * ここに書く cw-binding / ccw-binding は「既定値」であって、
         * Studio で設定するとそちらが優先される。つまり今のマウススクロール
         * の動作はそのまま維持され、気に入らなければ画面で変えられる。
         *
         * cw = 標準版の bindings の1個目、ccw = 2個目に相当。
         * 実機で方向が逆だったため入れ替えた結果をそのまま引き継いでいる。
         */

        // 左エンコーダー(sensors の0番): 縦スクロール。左回し=上 / 右回し=下。
        scroll_vertical: scroll_vertical {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <25>;
            cw-binding = <&msc ENC_UP>;
            ccw-binding = <&msc ENC_DOWN>;
        };

        // 右エンコーダー(sensors の1番): 横スクロール。左回し=左 / 右回し=右。
        scroll_horizontal: scroll_horizontal {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <25>;
            cw-binding = <&msc ENC_LEFT>;
            ccw-binding = <&msc ENC_RIGHT>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        /* =================================================================
         * レイヤー0: 基本
         * DYA Studio 上で利用者が調整した内容をそのまま反映してある。
         *   ・L1 は MO(押している間)ではなく TO(切り替え)。左内側の V B の右。
         *     戻るときは L1 側の同じ位置にある TO 0 を押す。
         *   ・L2 は左親指の一番外側で MO(押している間だけ)。
         *   ・Win は左下段からその左親指の隣へ移動。
         *   ・右下段は Caps と - を配置。半角/全角と変換は置いていない。
         * ================================================================= */
        base_layer {
            display-name = "Base";

            /* 1個目=左手エンコーダー、2個目=右手エンコーダー */
            sensor-bindings = <&scroll_vertical &scroll_horizontal>;

            bindings = <
    /* 左1段  Esc Q W E | R T      */  &kp ESC    &kp Q      &kp W      &kp E             &kp R       &kp T
    /* 左2段  Tab A S D | F G      */  &kp TAB    &kp A      &kp S      &kp D             &kp F       &kp G
    /* 左3段  Sft Z X C | V B TO1  */  &kp LSHFT  &kp Z      &kp X      &kp C             &kp V       &kp B      &to 1
    /* 左4段  Ctl -- Alt 無変換 | Spc Win L2 */
                                       &kp LCTRL  &trans     &kp LALT   &kp INT_MUHENKAN  &kp SPACE   &kp LGUI   &mo 2

    /* 右1段  外:I O P ;  内:Y U   */  &kp I      &kp O      &kp P      &kp SEMI    &kp Y      &kp U
    /* 右2段  外:K L @ :  内:H J   */  &kp K      &kp L      &kp LBKT   &kp SQT     &kp H      &kp J
    /* 右3段  外:, . / \  内:B N M */  &kp COMMA  &kp DOT    &kp FSLH   &kp INT_RO  &kp B      &kp N      &kp M
    /* 右4段  外:Caps - -- L3   内:Ent BS Del */
                                       &kp CAPS   &kp MINUS  &trans     &mo 3       &kp RET    &kp BSPC   &kp DEL

    /* エンコーダー押し込み: 左=左クリック 右=右クリック */
                                       &mkp LCLK  &mkp RCLK
            >;
        };

        /* =================================================================
         * レイヤー1: テンキー・ファンクション (基本層の TO 1 で切り替え)
         * 押しっぱなしではなく切り替え式なので、戻るときは同じ位置の TO 0。
         * 左手がテンキーそのままの並び、右手がF1〜F12(下から上へ)。
         * 右手内側の最下段はメディア操作(前の曲 / 再生停止 / 次の曲)。
         * ================================================================= */
        num_layer {
            display-name = "Num";
            bindings = <
    /* 左1段  7 8 9 / | -- Num   */  &kp N7     &kp N8     &kp N9     &kp KP_DIVIDE    &trans     &kp KP_NUM
    /* 左2段  4 5 6 * | -- --    */  &kp N4     &kp N5     &kp N6     &kp KP_MULTIPLY  &trans     &trans
    /* 左3段  1 2 3 - | -- -- TO0 */  &kp N1     &kp N2     &kp N3     &kp KP_MINUS     &trans     &trans     &to 0
    /* 左4段  0 . = + | Ent Sft BS */
                                      &kp N0     &kp KP_DOT &kp KP_EQUAL &kp KP_PLUS    &kp RET    &kp LSHFT  &kp BSPC

    /* 右1段  外:-- F10 F11 F12  内:-- -- */  &trans   &kp F10  &kp F11  &kp F12  &trans   &trans
    /* 右2段  外:-- F7 F8 F9     内:-- -- */  &trans   &kp F7   &kp F8   &kp F9   &trans   &trans
    /* 右3段  外:-- F4 F5 F6     内:-- -- -- */
                                              &trans   &kp F4   &kp F5   &kp F6   &trans   &trans   &trans
    /* 右4段  外:-- F1 F2 F3     内:前 再生 次 */
                                              &trans   &kp F1   &kp F2   &kp F3   &kp C_PREV &kp C_PP &kp C_NEXT

                                              &trans   &trans
            >;
        };

        /* =================================================================
         * レイヤー2: 矢印・編集 (左親指 L2 を押しながら)
         * 矢印は H J K L の位置に ← ↓ ↑ → (vim風)。
         * 左手には Ctrl+Z/X/C/V などを同じ文字の位置に置いてある。
         * ================================================================= */
        nav_layer {
            display-name = "Nav";
            bindings = <
    /* 左1段  -- -- -- -- | -- -- */  &trans     &none      &none      &none      &none      &none
    /* 左2段  -- 全選択 保存 -- | 検索 -- */
                                      &trans     &kp LC(A)  &kp LC(S)  &none      &kp LC(F)  &none
    /* 左3段  -- 戻す 切取 コピー | 貼付 やり直し -- */
                                      &trans     &kp LC(Z)  &kp LC(X)  &kp LC(C)  &kp LC(V)  &kp LC(Y)  &trans
    /* 左4段  基本段のまま        */  &trans     &trans     &trans     &trans     &trans     &trans     &trans

    /* 右1段  外:-- -- -- --      内:PgUp PgDn */
                                      &none      &none      &none      &none      &kp PG_UP  &kp PG_DN
    /* 右2段  外:↑ → Home End   内:← ↓    */
                                      &kp UP     &kp RIGHT  &kp HOME   &kp END    &kp LEFT   &kp DOWN
    /* 右3段  基本段のまま        */  &trans     &trans     &trans     &trans     &trans     &trans     &trans
    /* 右4段  基本段のまま        */  &trans     &trans     &trans     &trans     &trans     &trans     &trans

                                      &trans     &trans
            >;
        };

        /* =================================================================
         * レイヤー3: システム (右端の L3 を押しながら)
         * Bluetoothの切替、出力先の切替、書き込みモードへの移行。
         * BT_CLR は「今選んでいるプロファイル」のペアリングだけを消す。
         * 全消しの BT_CLR_ALL は誤爆が怖いので置いていない。
         * &bootloader と &sys_reset は押した側の半身に効く。
         *
         * 【L3 + D = Studioのロック解除】
         * ZMK Studio は既定でロックされており(ZMK_STUDIO_RPC が
         * imply ZMK_STUDIO_LOCKING しているため)、解除しないと編集が
         * 拒否される。切断するたび再ロックされるので、Studioで編集する
         * 前に毎回この組み合わせを押す。
         * ================================================================= */
        sys_layer {
            display-name = "Sys";
            bindings = <
    /* 左1段  -- BT0 BT1 BT2 | BT3 BT4 */
                                      &trans   &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
    /* 左2段  -- USB BLE Studio解除 | -- -- */
                                      &trans   &out OUT_USB  &out OUT_BLE  &studio_unlock  &none       &none
    /* 左3段  -- ペア消去 -- -- | 書込 再起動 -- */
                                      &trans   &bt BT_CLR    &none         &none         &bootloader   &sys_reset  &trans
    /* 左4段  基本段のまま      */    &trans   &trans        &trans        &trans        &trans        &trans      &trans

    /* 右1段  すべて無効        */    &none    &none    &none        &none        &none    &none
    /* 右2段  すべて無効        */    &none    &none    &none        &none        &none    &none
    /* 右3段  外:-- -- 書込 再起動   内:-- -- -- */
                                      &none    &none    &bootloader  &sys_reset   &none    &none    &none
    /* 右4段  基本段のまま      */    &trans   &trans   &trans       &trans       &trans   &trans   &trans

                                      &trans   &trans
            >;
        };
    };
};
