#include <dt-bindings/zmk/matrix_transform.h>
#include <physical_layouts.dtsi>
#include <zephyr/dt-bindings/gpio/gpio.h>

/*
 * ==================== ロータリーエンコーダー ====================
 * 【重要】左右のエンコーダーは必ずこの共通ファイルで「両方」定義し、
 * sensors にも両方並べること。使う側だけを overlay で okay にする。
 *
 * 理由: 分割キーボードでは子機が自分のローカルなセンサー番号をそのまま
 * 親機へ送り、親機は変換せずに使う(central.c: .sensor_index = そのまま)。
 * 子機側で sensors = <&right_encoder> とだけ書くと右エンコーダが0番になり、
 * 左エンコーダと同じ keymap の sensor-bindings[0] を引いてしまう。
 * 実際「左も右も縦スクロールになる」症状が出た。
 * 両方を同じ順で並べれば 左=0番 / 右=1番 が左右のビルドで一致する。
 *
 * 無効側は DEVICE_DT_GET_OR_NULL で NULL になり、初期化時に
 * 「No local device for N」とログを出してスキップされるだけなので安全。
 *
 * D9=P1.14, D10=P1.15。kscan と同じく GPIO を直接指定する。
 */
/ {
    left_encoder: left_encoder {
        compatible = "alps,ec11";
        a-gpios = <&gpio1 14 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        b-gpios = <&gpio1 15 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        // resolution は非推奨。現在は steps(1回転あたりの総パルス数)で指定する。
        // 一般的なEC11: 20クリック x 4パルス = 80
        steps = <80>;
        status = "disabled";
    };

    right_encoder: right_encoder {
        compatible = "alps,ec11";
        a-gpios = <&gpio1 14 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        b-gpios = <&gpio1 15 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        steps = <80>;
        status = "disabled";
    };

    sensors: sensors {
        compatible = "zmk,keymap-sensors";
        // 並び順がそのまま keymap の sensor-bindings の順になる。
        sensors = <&left_encoder &right_encoder>;
        // 1回転あたりの反応回数。steps=80 は4パルス/ノッチなので20ノッチ/回転。
        // 20 = 1ノッチ1回、40 = 1ノッチ2回。
        triggers-per-rotation = <20>;
    };
};

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,physical-layout = &layout_main;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <18>;
        rows = <9>;
        /*
         * map の並び順 = keymap の bindings の並び順 = 下の keys の並び順。
         * 各段は「外側4キー → 内側」の順(左手なら x=0〜300 → 400〜600、
         * 右手なら x=1100〜1400 → 800〜1000)。
         *
         * 【右手は鏡像】右手の基板は左手の鏡像なので、同じ配線順(SW1,SW2…)
         * が物理的には右から左へ並ぶ。実測で確認:
         *   行0で 一番右=SW1(I) / 右2番目=SW2(O) / … / 内側左=SW6(U)
         * そのため右手側だけ、各段で並びを反転させてある。
         * 反転させないと「段ごとに左右が入れ替わって打たれる」症状になる。
         */
        map = <
            /* ================= 左手 26キー =================
               SW1〜SW26 が視覚的な左→右・上→下の順に並ぶ(こちらは素直) */
            /* 1段 x=0,100,200,300 | 400,500 */
            RC(0,5) RC(1,5) RC(2,5) RC(3,5)   RC(4,5) RC(0,6)
            /* 2段 */
            RC(1,6) RC(2,6) RC(3,6) RC(4,6)   RC(0,7) RC(1,7)
            /* 3段 (内側が3キー) */
            RC(2,7) RC(5,0) RC(5,1) RC(5,2)   RC(5,3) RC(5,4) RC(6,0)
            /* 4段 (内側が3キー) */
            RC(6,1) RC(6,2) RC(6,3) RC(6,4)   RC(7,0) RC(7,1) RC(7,2)

            /* ================= 右手 26キー =================
               col-offset=9 を織り込み済み。左手と違い各段が反転している。
               外側は x=1100→1400 の順に SW4,SW3,SW2,SW1 と並ぶ。 */
            /* 1段 x=1100,1200,1300,1400 | 900,1000 */
            RC(3,14) RC(2,14) RC(1,14) RC(0,14)   RC(0,15) RC(4,14)
            /* 2段 */
            RC(4,15) RC(3,15) RC(2,15) RC(1,15)   RC(1,16) RC(0,16)
            /* 3段 (内側が3キー: x=800,900,1000) */
            RC(5,11) RC(5,10) RC(5,9) RC(2,16)   RC(6,9) RC(5,13) RC(5,12)
            /* 4段 (内側が3キー) */
            RC(6,13) RC(6,12) RC(6,11) RC(6,10)   RC(7,11) RC(7,10) RC(7,9)

            /* ロータリーエンコーダー押し込み(左・右)。1キーなので反転は無関係 */
            RC(0,8) RC(0,17)
        >;
    };

    layout_main: layout_main {
        compatible = "zmk,physical-layout";
        display-name = "Default Layout";
        transform = <&default_transform>;
        kscan = <&kscan0>;
        keys
            = <&key_physical_attrs 100 100   0   0 0 0 0> , <&key_physical_attrs 100 100 100   0 0 0 0> , <&key_physical_attrs 100 100 200   0 0 0 0> , <&key_physical_attrs 100 100 300   0 0 0 0> , <&key_physical_attrs 100 100 400  50 0 0 0> , <&key_physical_attrs 100 100 500  50 0 0 0>
            , <&key_physical_attrs 100 100   0 100 0 0 0> , <&key_physical_attrs 100 100 100 100 0 0 0> , <&key_physical_attrs 100 100 200 100 0 0 0> , <&key_physical_attrs 100 100 300 100 0 0 0> , <&key_physical_attrs 100 100 400 150 0 0 0> , <&key_physical_attrs 100 100 500 150 0 0 0>
            , <&key_physical_attrs 100 100   0 200 0 0 0> , <&key_physical_attrs 100 100 100 200 0 0 0> , <&key_physical_attrs 100 100 200 200 0 0 0> , <&key_physical_attrs 100 100 300 200 0 0 0> , <&key_physical_attrs 100 100 400 250 0 0 0> , <&key_physical_attrs 100 100 500 250 0 0 0> , <&key_physical_attrs 100 100 600 250 0 0 0>
            , <&key_physical_attrs 100 100   0 300 0 0 0> , <&key_physical_attrs 100 100 100 300 0 0 0> , <&key_physical_attrs 100 100 200 300 0 0 0> , <&key_physical_attrs 100 100 300 300 0 0 0> , <&key_physical_attrs 100 100 400 350 0 0 0> , <&key_physical_attrs 100 100 500 350 0 0 0> , <&key_physical_attrs 100 100 600 350 0 0 0>
            , <&key_physical_attrs 100 100 1100   0 0 0 0> , <&key_physical_attrs 100 100 1200   0 0 0 0> , <&key_physical_attrs 100 100 1300   0 0 0 0> , <&key_physical_attrs 100 100 1400   0 0 0 0> , <&key_physical_attrs 100 100  900  50 0 0 0> , <&key_physical_attrs 100 100 1000  50 0 0 0>
            , <&key_physical_attrs 100 100 1100 100 0 0 0> , <&key_physical_attrs 100 100 1200 100 0 0 0> , <&key_physical_attrs 100 100 1300 100 0 0 0> , <&key_physical_attrs 100 100 1400 100 0 0 0> , <&key_physical_attrs 100 100  900 150 0 0 0> , <&key_physical_attrs 100 100 1000 150 0 0 0>
            , <&key_physical_attrs 100 100 1100 200 0 0 0> , <&key_physical_attrs 100 100 1200 200 0 0 0> , <&key_physical_attrs 100 100 1300 200 0 0 0> , <&key_physical_attrs 100 100 1400 200 0 0 0> , <&key_physical_attrs 100 100  800 250 0 0 0> , <&key_physical_attrs 100 100  900 250 0 0 0> , <&key_physical_attrs 100 100 1000 250 0 0 0>
            , <&key_physical_attrs 100 100 1100 300 0 0 0> , <&key_physical_attrs 100 100 1200 300 0 0 0> , <&key_physical_attrs 100 100 1300 300 0 0 0> , <&key_physical_attrs 100 100 1400 300 0 0 0> , <&key_physical_attrs 100 100  800 350 0 0 0> , <&key_physical_attrs 100 100  900 350 0 0 0> , <&key_physical_attrs 100 100 1000 350 0 0 0>
            , <&key_physical_attrs  80  80 650 150 0 0 0> , <&key_physical_attrs  80  80 750 150 0 0 0>
            ;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-charlieplex";
        wakeup-source;

        /*
         * 【重要】スキャン間隔。既定値はどちらも 1ms しかない。
         * このドライバの待ち時間は k_busy_wait() = CPUを回して待つ実装で、
         * 9本のピンを1周するのに 9×(前+後) だけかかる。150µsでも2.7ms、
         * 以前の500µsでは9ms。それを1ms間隔で回そうとするため、次の予定
         * 時刻が常に過去になり、スキャンが間断なく連続実行されていた。
         * = CPUをほぼ100%空回りで占有。
         *
         * その結果ペアリングの鍵計算(ECDH)が終わらず、
         *   親機 bt_smp_pkey_ready = 67.9秒 / 子機 = 101.1秒
         * SMPの30秒タイムアウトに間に合わず左右の接続が永久に失敗していた。
         * (本来この計算は10秒弱で終わる)
         *
         * 20ms / 10ms にすれば待機中の占有は 2.7/20 = 約14%まで下がる。
         * 押下検知の遅れは最大でも20ms程度で体感できない。
         */
        poll-period-ms = <20>;
        debounce-scan-period-ms = <10>;
    };
};

&uicr {
    nfct-pins-as-gpios;
};

&uart0 {
    status = "disabled";
};

&i2c1 {
    status = "disabled";
};

&spi2 {
    status = "disabled";
};
