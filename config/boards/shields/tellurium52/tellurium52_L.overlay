#include "tellurium52.dtsi"

// 【検証用】3本テストのイベント座標を見える位置に割り当てる。
// position 0 = RC(0,2) -> A、position 1 = RC(1,2) -> Q。他は元のまま。
&default_transform {
    map = <
        RC(0,2) RC(1,2) RC(2,5) RC(3,5) RC(4,5) RC(0,6)
        RC(1,6) RC(2,6) RC(3,6) RC(4,6) RC(0,7) RC(1,7)
        RC(2,7) RC(5,0) RC(5,1) RC(5,2) RC(5,3) RC(5,4)
        RC(6,0) RC(6,1) RC(6,2) RC(6,3) RC(6,4) RC(7,0)
        RC(7,1) RC(7,2)

        RC(0,14) RC(1,14) RC(2,14) RC(3,14) RC(4,14) RC(0,15)
        RC(1,15) RC(2,15) RC(3,15) RC(4,15) RC(0,16) RC(1,16)
        RC(2,16) RC(5,9) RC(5,10) RC(5,11) RC(5,12) RC(5,13)
        RC(6,9) RC(6,10) RC(6,11) RC(6,12) RC(6,13) RC(7,9)
        RC(7,10) RC(7,11)

        RC(0,8) RC(0,17)
    >;
};

// 【標準マトリクスドライバでの検証】
// チャーリープレックスをやめて、実績豊富な kscan-gpio-matrix を使う。
// 順方向スイッチ(Row->Col)だけを対象にした 5行x4列 の普通のマトリクス。
// SW11 は Row0 x Col2 なので、押すと RC(0,2) -> position0 -> "a" が1文字だけ出るはず。
&kscan0 {
    compatible = "zmk,kscan-gpio-matrix";
    diode-direction = "row2col";
    /delete-property/ gpios;

    row-gpios
        = <&xiao_d 0 GPIO_ACTIVE_HIGH> // Row0
        , <&xiao_d 1 GPIO_ACTIVE_HIGH> // Row1
        , <&xiao_d 2 GPIO_ACTIVE_HIGH> // Row2
        , <&xiao_d 3 GPIO_ACTIVE_HIGH> // Row3
        , <&xiao_d 4 GPIO_ACTIVE_HIGH> // Row4
        ;

    col-gpios
        = <&xiao_d 5 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // Col0
        , <&xiao_d 6 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // Col1
        , <&xiao_d 7 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // Col2
        , <&xiao_d 8 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // Col3
        ;
};

/ {
