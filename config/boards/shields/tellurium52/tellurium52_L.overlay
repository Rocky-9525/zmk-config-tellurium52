#include "tellurium52.dtsi"

&kscan0 {
    // 【段階テスト3】2本=正常、6本=幽霊。行を1本だけ足した3本で最小再現を探る。
    // 期待(正常なら): 押すと "Sending event at 0,2" だけが出る。
    // "1,2" も出たら、行1本足すだけで再現する = 最小再現条件が判明。
    gpios
        = <&xiao_d 0 GPIO_ACTIVE_HIGH> // 0番: Row0
        , <&xiao_d 1 GPIO_ACTIVE_HIGH> // 1番: Row1
        , <&xiao_d 7 GPIO_ACTIVE_HIGH> // 2番: Col2
        ;
};

