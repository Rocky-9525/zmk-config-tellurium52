#include "tellurium52.dtsi"

// 【本番構成】チャーリープレックス方式に復帰。
// 26キーを識別するにはこの方式が必要(マトリクス方式では20マスしか無く、
// SW14〜26 が SW1〜13 と同じ座標になってしまうため)。
// 幽霊イベントの原因は「金属ピンセットを手で握って測っていたこと」だったので、
// この方式自体には問題が無かった可能性が高い。
&kscan0 {
    // xiao_d の中継を経由せず、GPIOコントローラを直接指定してプルダウンを確実にする。
    //   D0=P0.02 D1=P0.03 D2=P0.28 D3=P0.29 D4=P0.04
    //   D5=P0.05 D6=P1.11 D7=P1.12 D8=P1.13
    gpios
        = <&gpio0  2 GPIO_ACTIVE_HIGH> // D0 = Row0
        , <&gpio0  3 GPIO_ACTIVE_HIGH> // D1 = Row1
        , <&gpio0 28 GPIO_ACTIVE_HIGH> // D2 = Row2
        , <&gpio0 29 GPIO_ACTIVE_HIGH> // D3 = Row3
        , <&gpio0  4 GPIO_ACTIVE_HIGH> // D4 = Row4
        , <&gpio0  5 GPIO_ACTIVE_HIGH> // D5 = Col0
        , <&gpio1 11 GPIO_ACTIVE_HIGH> // D6 = Col1
        , <&gpio1 12 GPIO_ACTIVE_HIGH> // D7 = Col2
        , <&gpio1 13 GPIO_ACTIVE_HIGH> // D8 = Col3
        ;
};

/ {
    // ロータリーエンコーダー(左手)。D9/D10 に A/B 相が繋がっている。
    // kscan と同じく GPIO を直接指定する。 D9=P1.14, D10=P1.15
    left_encoder: left_encoder {
        compatible = "alps,ec11";
        a-gpios = <&gpio1 14 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        b-gpios = <&gpio1 15 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        // resolution は非推奨。現在は steps(1回転あたりの総パルス数)で指定する。
        // 一般的なEC11: 20クリック x 4パルス = 80
        steps = <80>;
        status = "okay";
    };

    sensors: sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&left_encoder>;
        // 1回転あたり何回反応させるか。20クリックのエンコーダなので20 = 1クリック1回。
        triggers-per-rotation = <20>;
    };
};
