#include "tellurium52.dtsi"

// 【検証用】3本テストのイベント座標を見える位置に割り当てる。
// position 0 = RC(0,2) -> A、position 1 = RC(1,2) -> Q。他は元のまま。
&default_transform {
    map = <
        /* 【座標地図】5行x4列の全マスに A〜T を割り当てる
              Col0 Col1 Col2 Col3
         Row0   A    B    C    D
         Row1   E    F    G    H
         Row2   I    J    K    L
         Row3   M    N    O    P
         Row4   Q    R    S    T                                   */
        RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(1,0) RC(1,1)
        RC(1,2) RC(1,3) RC(2,0) RC(2,1) RC(2,2) RC(2,3)
        RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(4,0) RC(4,1)
        RC(4,2) RC(4,3) RC(6,0) RC(6,1) RC(6,2) RC(6,3)
        RC(6,4) RC(7,2)

        RC(0,14) RC(1,14) RC(2,14) RC(3,14) RC(4,14) RC(0,15)
        RC(1,15) RC(2,15) RC(3,15) RC(4,15) RC(0,16) RC(1,16)
        RC(2,16) RC(5,9) RC(5,10) RC(5,11) RC(5,12) RC(5,13)
        RC(6,9) RC(6,10) RC(6,11) RC(6,12) RC(6,13) RC(7,9)
        RC(7,10) RC(7,11)

        RC(0,8) RC(0,17)
    >;
};

// 【標準マトリクスドライバでの検証】
// チャーリープレックスをやめて、実績豊富な kscan-gpio-matrix を使う。
// 順方向スイッチ(Row->Col)だけを対象にした 5行x4列 の普通のマトリクス。
// SW11 は Row0 x Col2 なので、押すと RC(0,2) -> position0 -> "a" が1文字だけ出るはず。
&kscan0 {
    compatible = "zmk,kscan-gpio-matrix";
    // 【本命】D1〜D13は図面と逆向きに実装されている(基板の角度180度+写真の帯位置から確認)。
    // よって電流は Col -> Row に流れる。走査方向を col2row にする。
    diode-direction = "col2row";
    /delete-property/ gpios;

    // 【本命】チャタリング除去を強めに設定する。
    // 押した瞬間の数ミリ秒だけ暴れる幽霊イベントをフィルタする。
    // 長押し中は正しく1キーだけなので、過渡的なノイズさえ除ければ正常になる。
    debounce-press-ms = <50>;
    debounce-release-ms = <50>;

    // 通常の5行x4列に戻す。待ち時間はconfで大きく設定して電荷の減衰を待つ。
    // col2row では 列が駆動側、行が読み取り側。プルダウンは行側に付ける。
    row-gpios
        = <&xiao_d 0 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // Row0(読み取り)
        , <&xiao_d 1 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // Row1
        , <&xiao_d 2 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // Row2
        , <&xiao_d 3 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // Row3
        , <&xiao_d 4 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // Row4
        ;

    col-gpios
        = <&xiao_d 5 GPIO_ACTIVE_HIGH> // Col0(駆動)
        , <&xiao_d 6 GPIO_ACTIVE_HIGH> // Col1
        , <&xiao_d 7 GPIO_ACTIVE_HIGH> // Col2
        , <&xiao_d 8 GPIO_ACTIVE_HIGH> // Col3
        ;
};

/ {
    // マトリクス検証のためエンコーダーを一時的に無効化(後で復活させます)
    // left_encoder: left_encoder {
