#include "tellurium52.dtsi"

&kscan0 {
    // 【最小構成テスト】ピンを2本だけにする。
    // 挿している1個のスイッチが使う xiao_d0(Row0) と xiao_d7(Col2) のみ。
    // 2本しかなければ幽霊が生まれる余地は構造的に無い。
    // 期待: 押すと "Sending event at 0,1"(または1,0)が1回だけ出る。
    // ※transformとは合わないので "Not found in transform" 警告が出るのは正常。生ログで判定する。
    gpios
        = <&xiao_d 0 GPIO_ACTIVE_HIGH> // 0番: Row0
        , <&xiao_d 7 GPIO_ACTIVE_HIGH> // 1番: Col2
        ;
};

/ {
    // マトリクス検証のためエンコーダーを一時的に無効化(後で復活させます)
